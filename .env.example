LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free

# Set to 1 to skip the model entirely and return a fixed schema-valid stub.
LLM_STUB=0

# Set to false to disable the model call and return a deterministic fallback.
LLM_ENABLED=true

REPORT_SCHEDULE_ENABLED=false
REPORT_SCHEDULE_INTERVAL_SECONDS=86400
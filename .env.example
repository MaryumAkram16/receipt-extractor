# --- Model provider (any OpenAI-compatible endpoint) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free

# Set to 1 to skip the model entirely and return a fixed schema-valid stub.
LLM_STUB=0

# Set to false to disable the model call and return a deterministic fallback.
LLM_ENABLED=true

# --- Background jobs ---
# Job-level attempts for transient failures (the LLM client already retries
# each call up to 3 times). Clamped to 1..5.
JOB_MAX_ATTEMPTS=2

# --- Diagnostics ---
# When true, quarantine records include the receipt text and raw model output.
# Leave false unless you are actively debugging a prompt.
DIAGNOSTIC_LOG_CONTENT=false

# --- Scheduled reports ---
REPORT_SCHEDULE_ENABLED=false
REPORT_SCHEDULE_INTERVAL_SECONDS=86400
